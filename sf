#!/bin/zsh
set -euo pipefail

ROOT=${0:A:h}
DERIVED_DATA=${SITEFORGE_DERIVED_DATA:-${TMPDIR%/}/SiteForge/DerivedData}
SCHEME=${SITEFORGE_SCHEME:-SiteForge}
DESTINATION=${SITEFORGE_DESTINATION:-platform=macOS}
CODEX_BIN=${SITEFORGE_CODEX_BIN:-}
TEST_FIXTURE_ROOT="$ROOT/.siteforge-test-fixtures"
TEST_SCOPE_SELECTOR="$ROOT/scripts/select-test-scope.py"
if [[ -n ${SITEFORGE_TEST_RESULTS_ROOT:-} ]]; then
  TEST_RESULTS_ROOT=$SITEFORGE_TEST_RESULTS_ROOT
elif [[ -n ${RUNNER_TEMP:-} ]]; then
  TEST_RESULTS_ROOT="$RUNNER_TEMP/SiteForge/TestResults"
else
  TEST_RESULTS_ROOT="${TMPDIR%/}/SiteForge/TestResults"
fi

if [[ -z "$CODEX_BIN" ]]; then
  if command -v codex >/dev/null 2>&1; then
    CODEX_BIN=$(command -v codex)
  elif [[ -x /Applications/ChatGPT.app/Contents/Resources/codex ]]; then
    CODEX_BIN=/Applications/ChatGPT.app/Contents/Resources/codex
  fi
fi

typeset -ga CONTAINER_ARGS
typeset -g SITEFORGE_UI_PROCESS_ENUMERATION_AVAILABLE=1

resolve_container() {
  if [[ -n ${SITEFORGE_WORKSPACE:-} ]]; then
    CONTAINER_ARGS=(-workspace "$SITEFORGE_WORKSPACE")
    return
  fi
  if [[ -n ${SITEFORGE_PROJECT:-} ]]; then
    CONTAINER_ARGS=(-project "$SITEFORGE_PROJECT")
    return
  fi

  local workspace project
  workspace=$(find "$ROOT" -maxdepth 2 -name '*.xcworkspace' \
    -not -path '*/.build/*' -not -path '*.xcodeproj/*' -print -quit)
  if [[ -n "$workspace" ]]; then
    CONTAINER_ARGS=(-workspace "$workspace")
    return
  fi
  project=$(find "$ROOT" -maxdepth 2 -name '*.xcodeproj' -not -path '*/.build/*' -print -quit)
  if [[ -n "$project" ]]; then
    CONTAINER_ARGS=(-project "$project")
    return
  fi

  print -u2 "No Xcode workspace or project was found."
  print -u2 "Create SiteForge.xcodeproj, or set SITEFORGE_WORKSPACE / SITEFORGE_PROJECT."
  return 2
}

build_app() {
  resolve_container
  xcodebuild "${CONTAINER_ARGS[@]}" -scheme "$SCHEME" -destination "$DESTINATION" -derivedDataPath "$DERIVED_DATA" build
}

test_app() {
  local level=${1:-full}
  local base=${2:-${SITEFORGE_TEST_BASE:-origin/main}}
  typeset -a test_arguments

  case "$level" in
    full|all)
      level=full
      ;;
    half|core)
      level=half
      test_arguments=(-only-testing:SiteForgeTests)
      ;;
    quick|smoke)
      level=quick
      test_arguments=(
        -only-testing:SiteForgeTests/AppMetadataTests
        -only-testing:SiteForgeTests/ArchitectureBoundaryTests
      )
      ;;
    changed|impacted)
      level=changed
      local selection
      selection=$("$TEST_SCOPE_SELECTOR" --root "$ROOT" --base "$base")
      if [[ "$selection" != FULL ]]; then
        local selector
        for selector in "${(@f)selection}"; do
          [[ -n "$selector" ]] && test_arguments+=("-only-testing:$selector")
        done
      else
        level="changed → full"
      fi
      ;;
    focused|exact)
      [[ -n "$base" ]] || { print -u2 "Provide one or more exact XCTest selectors after 'focused'."; return 2; }
      level=focused
      local selector
      test_arguments+=("-only-testing:$base")
      shift 2
      for selector in "$@"; do
        test_arguments+=("-only-testing:$selector")
      done
      ;;
    *)
      print -u2 "Unknown test level: $level"
      print -u2 "Choose quick, changed, half, or full."
      return 2
      ;;
  esac

  print "Running SiteForge test level: $level"
  resolve_container
  prepare_siteforge_ui_process_enumeration
  terminate_stale_siteforge_ui_processes
  cleanup_test_fixtures
  trap cleanup_test_fixtures EXIT
  local test_run_id
  test_run_id=$(uuidgen | tr '[:upper:]' '[:lower:]')
  export SITEFORGE_TEST_RUN_ID="$test_run_id"
  local result_bundle="$TEST_RESULTS_ROOT/${level// /-}-${test_run_id}.xcresult"
  mkdir -p "${result_bundle:h}"
  local test_status log_path
  log_path="${result_bundle:r}.log"
  set +e
  xcodebuild "${CONTAINER_ARGS[@]}" -scheme "$SCHEME" -destination "$DESTINATION" -derivedDataPath "$DERIVED_DATA" -resultBundlePath "$result_bundle" test "${test_arguments[@]}" 2>&1 | tee "$log_path"
  test_status=${pipestatus[1]}
  set -e
  cleanup_test_fixtures
  assert_no_orphaned_siteforge_ui_processes
  trap - EXIT
  return "$test_status"
}

# Test-run cleanup is deliberately narrower than a bundle-ID-wide kill: it
# only touches abandoned processes from this repository's derived-data tree
# whose command line carries SiteForge UI-test ownership. A user's normal
# SiteForge installation or unrelated Xcode job is never a candidate.
prepare_siteforge_ui_process_enumeration() {
  # Some managed execution environments intentionally deny process listing.
  # Probe that capability once before entering the set -e cleanup path. When
  # available, later enumeration remains strict and an unexpected ps failure
  # is still surfaced; when unavailable, XCTest and the fixture EXIT trap
  # remain safe lifecycle owners for this one invocation.
  if ps -axo pid=,command= >/dev/null 2>/dev/null; then
    SITEFORGE_UI_PROCESS_ENUMERATION_AVAILABLE=1
  else
    SITEFORGE_UI_PROCESS_ENUMERATION_AVAILABLE=0
    print -u2 "Warning: process enumeration is unavailable; skipping SiteForge UI stale/orphan checks for this test invocation."
  fi
}

siteforge_ui_process_ids() {
  (( SITEFORGE_UI_PROCESS_ENUMERATION_AVAILABLE )) || return 0
  ps -axo pid=,command= | while read -r pid command; do
    [[ -n "$pid" && -n "$command" ]] || continue
    if [[ "$command" == *"$DERIVED_DATA"* ]] && {
      [[ "$command" == *"SiteForgeUITests-Runner"* ]] ||
      [[ "$command" == *"SiteForge.app/Contents/MacOS/SiteForge"*"-SiteForgeUITestMode"* ]] ||
      [[ "$command" == *"xcodebuild"*"$ROOT"*"$DESTINATION"* ]]
    }; then
      print -- "$pid"
    fi
  done
}

terminate_stale_siteforge_ui_processes() {
  local -a stale_pids
  stale_pids=( ${(f)$(siteforge_ui_process_ids)} )
  (( ${#stale_pids} == 0 )) && return
  print "Terminating stale SiteForge UI-test processes: ${stale_pids[*]}"
  kill -TERM -- "${stale_pids[@]}" 2>/dev/null || true
  local attempt pid
  for attempt in {1..20}; do
    local -a live
    live=()
    for pid in "${stale_pids[@]}"; do
      kill -0 "$pid" 2>/dev/null && live+=("$pid")
    done
    (( ${#live} == 0 )) && return
    sleep 0.1
  done
  print -u2 "Stale SiteForge UI-test processes did not terminate: ${stale_pids[*]}"
  return 1
}

assert_no_orphaned_siteforge_ui_processes() {
  local -a orphaned
  orphaned=( ${(f)$(siteforge_ui_process_ids)} )
  if (( ${#orphaned} > 0 )); then
    print -u2 "SiteForge UI-test processes remain after test completion: ${orphaned[*]}"
    return 1
  fi
}

cleanup_test_fixtures() {
  if [[ -d "$TEST_FIXTURE_ROOT" ]]; then
    rm -rf -- "$TEST_FIXTURE_ROOT"
  fi
}

run_app() {
  local app
  app=$(find "$DERIVED_DATA/Build/Products" -type d -name 'SiteForge.app' -print -quit 2>/dev/null || true)
  if [[ -z "$app" ]]; then
    build_app
    app=$(find "$DERIVED_DATA/Build/Products" -type d -name 'SiteForge.app' -print -quit)
  fi
  open "$app"
}

usage() {
  cat <<'EOF'
SiteForge local commands

  ./sf dev             Build and launch SiteForge locally
  ./sf build           Build the macOS app
  ./sf test [level]    Run quick, changed, half, focused, or full tests
  ./sf test focused <XCTest selector> [selector...]
  ./sf verify          Run repository checks, build, and tests
  ./sf watch           Re-run verification when source files change
  ./sf next            Ask Codex to complete the next ready queue item
  ./sf loop [count]    Let Codex process up to count items (default 5)
  ./sf status          Show project, queue, and git status
  ./sf release-local   Create an unsigned local alpha ZIP; never publish

Optional environment variables:
  SITEFORGE_SCHEME, SITEFORGE_WORKSPACE, SITEFORGE_PROJECT,
  SITEFORGE_DESTINATION, SITEFORGE_DERIVED_DATA, SITEFORGE_CODEX_BIN,
  SITEFORGE_TEST_BASE (default origin/main for the changed level)
EOF
}

case ${1:-help} in
  dev)
    build_app
    run_app
    ;;
  build)
    build_app
    ;;
  test)
    test_app "${@:2}"
    ;;
  verify)
    "$ROOT/scripts/check-repository.sh"
    build_app
    test_app full
    ;;
  watch)
    exec "$ROOT/scripts/watch-and-verify.sh"
    ;;
  next)
    [[ -n "$CODEX_BIN" ]] || { print -u2 "Codex CLI was not found."; exit 2; }
    mkdir -p "$ROOT/.codex-loop"
    "$CODEX_BIN" exec -C "$ROOT" -s workspace-write -o "$ROOT/.codex-loop/last-message.md" - < "$ROOT/docs/CODEX_NEXT_PROMPT.md"
    ;;
  loop)
    [[ -n "$CODEX_BIN" ]] || { print -u2 "Codex CLI was not found."; exit 2; }
    exec "$ROOT/scripts/codex-loop.sh" "${2:-5}"
    ;;
  status)
    "$ROOT/scripts/project-status.sh"
    ;;
  release-local)
    "$ROOT/scripts/package-local-alpha.sh"
    ;;
  help|-h|--help)
    usage
    ;;
  *)
    print -u2 "Unknown command: $1"
    usage
    exit 2
    ;;
esac
